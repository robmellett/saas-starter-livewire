parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Console\\Commands\\Paddle\\FakeWebhook\:\:resolveCustomer\(\) should return Laravel\\Paddle\\Customer\|null but returns Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: return.type
			count: 1
			path: app/Console/Commands/Paddle/FakeWebhook.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:currentPlan\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Middleware/RequiresPlan.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:subscription\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Livewire/Billing/PendingPayment.php

		-
			message: '#^Property App\\Livewire\\Billing\\PendingPayment\:\:\$workspace \(App\\Models\\Workspace\) does not accept Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Livewire/Billing/PendingPayment.php

		-
			message: '#^Property App\\Livewire\\Billing\\PlanPicker\:\:\$workspace \(App\\Models\\Workspace\) does not accept Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Livewire/Billing/PlanPicker.php

		-
			message: '#^Property App\\Livewire\\Billing\\SubscriptionPanel\:\:\$workspace \(App\\Models\\Workspace\) does not accept Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Livewire/Billing/SubscriptionPanel.php

		-
			message: '#^Method App\\Models\\User\:\:currentWorkspace\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/User.php

		-
			message: '#^Method App\\Models\\User\:\:workspaces\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany does not specify its types\: TRelatedModel, TDeclaringModel, TPivotModel, TAccessor \(2\-4 required\)$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/User.php

		-
			message: '#^Method App\\Models\\Workspace\:\:members\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany does not specify its types\: TRelatedModel, TDeclaringModel, TPivotModel, TAccessor \(2\-4 required\)$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Workspace.php

		-
			message: '#^Instanceof between Laravel\\Paddle\\Billable and App\\Models\\Workspace will always evaluate to false\.$#'
			identifier: instanceof.alwaysFalse
			count: 1
			path: src/Domain/Billing/Listeners/SyncSubscriptionPlan.php

		-
			message: '#^Strict comparison using \!\=\= between string and Domain\\Workspaces\\Enums\\WorkspacePlan will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Domain/Billing/Listeners/SyncSubscriptionPlan.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Relations\\Pivot\:\:\$role\.$#'
			identifier: property.notFound
			count: 1
			path: src/Domain/Workspaces/Policies/WorkspacePolicy.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$id\.$#'
			identifier: property.notFound
			count: 1
			path: tests/Feature/Auth/RegistrationTest.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$name\.$#'
			identifier: property.notFound
			count: 1
			path: tests/Feature/Auth/RegistrationTest.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$plan\.$#'
			identifier: property.notFound
			count: 1
			path: tests/Feature/Auth/RegistrationTest.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Relations\\Pivot\:\:\$role\.$#'
			identifier: property.notFound
			count: 1
			path: tests/Feature/Auth/RegistrationTest.php

		-
			message: '#^Call to an undefined static method Illuminate\\Support\\Facades\\Log\:\:shouldHaveReceived\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: tests/Feature/Billing/PaymentMethodControllerTest.php

		-
			message: '#^Unable to resolve the template type TComponent in call to method Livewire\\LivewireManager\:\:test\(\)$#'
			identifier: argument.templateType
			count: 1
			path: tests/Feature/Billing/PendingPaymentTest.php

		-
			message: '#^Unable to resolve the template type TComponent in call to method Livewire\\LivewireManager\:\:test\(\)$#'
			identifier: argument.templateType
			count: 2
			path: tests/Feature/Billing/PlanPickerTest.php

		-
			message: '#^Unable to resolve the template type TComponent in call to method Livewire\\LivewireManager\:\:test\(\)$#'
			identifier: argument.templateType
			count: 5
			path: tests/Feature/Billing/SubscriptionPanelTest.php

		-
			message: '#^Method Tests\\Feature\\Billing\\WebhookSignatureTest\:\:signedPost\(\) has parameter \$payload with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Feature/Billing/WebhookSignatureTest.php

		-
			message: '#^Method Tests\\Feature\\Billing\\WebhookSignatureTest\:\:signedPost\(\) return type with generic class Illuminate\\Testing\\TestResponse does not specify its types\: TResponse$#'
			identifier: missingType.generics
			count: 1
			path: tests/Feature/Billing/WebhookSignatureTest.php
